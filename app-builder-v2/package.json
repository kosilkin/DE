{
  "name": "app-builder-v2",
  "version": "2.0.0",
  "description": "Конструктор учебных информационных систем — desktop-приложение на Electron",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "test:smoke": "node scripts/smoke-test.js",
    "test:ui": "npx playwright test --config=playwright.config.js",
    "test:desktop": "node scripts/desktop-smoke-test.js",
    "build:win": "electron-builder --win --config electron-builder.json",
    "build:linux": "electron-builder --linux --config electron-builder.json",
    "build:mac": "electron-builder --mac --config electron-builder.json",
    "build": "electron-builder --config electron-builder.json"
  },
  "author": {
    "name": "KorokNET",
    "email": "kosilkinmiha@gmail.com"
  },
  "homepage": "https://github.com/kosilkin/DE",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "@playwright/test": "^1.49.0"
  }
}
